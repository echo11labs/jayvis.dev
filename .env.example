# ==============================================================================
# JAYVIS ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- [LOCAL MODE (DEFAULT)] ---
# Runs 100% offline with zero external dependencies or setup required.
DATABASE_URL=file:./dev.db
DBML_PARSER_URL=http://127.0.0.1:3031
DBML_PARSER_TIMEOUT_MS=5000

# --- [OPTIONAL: CLOUD STORAGE & CLERK AUTHENTICATION] ---
# Leave empty to keep JayVis running in zero-login Local Mode.
# To enable multi-device Cloud Sync and user accounts:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Production database URL (e.g. Neon, Supabase, Postgres)
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/jayvis

# Comma-separated hostnames allowed to call parse, export, migrate, and SQL build.
# Empty on a laptop / local dev. The production VM deploy sets the public address.
JAYVIS_PUBLIC_HOSTS=35.202.154.195,jayvis.echo11.tech

