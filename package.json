{
  "name": "jayvis.dev",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names parser,web --prefix-colors magenta,cyan \"npm:dev:parser\" \"npm:dev:web\"",
    "dev:web": "next dev -p 3000",
    "dev:parser": "tsx watch mini-services/dbml-parser/index.ts",
    "build": "next build",
    "start": "prisma migrate deploy && concurrently --kill-others-on-fail --names parser,web --prefix-colors magenta,cyan \"npm:start:parser\" \"npm:start:web\"",
    "start:web": "next start -p 3000",
    "start:parser": "tsx mini-services/dbml-parser/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run test",
    "verify": "bash verify.sh",
    "db:push": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
